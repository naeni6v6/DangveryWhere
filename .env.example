# NAVER Maps Client ID (public). Enable Web Dynamic Map and register local/deployed URLs.
PUBLIC_NAVER_MAP_CLIENT_ID=
# Server-only Neon connection string. Never use a PUBLIC_ prefix.
DATABASE_URL=
# Optional Kakao login only. Password accounts need DATABASE_URL, without a Kakao key.
# Exact public origin, with no trailing slash. Register /auth/kakao/callback.
APP_ORIGIN=http://127.0.0.1:5173
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# data.go.kr 일반 인증키(Decoding). 한국관광공사 반려동물 동반여행 서비스(15135102). 서버 전용.
DATA_GO_KR_SERVICE_KEY=
# 내 강아지 캐릭터 만들기 (사진 → 3D 캐릭터). 모두 서버 전용.
# Google AI Studio 키. 이미지 생성·부위 탐지·(Claude 키가 없을 때) 사진 분석에 씁니다.
GEMINI_API_KEY=
# 이미지 생성 모델. 없으면 gemini-3.1-flash-image → 실패 시 gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=
# 부위 탐지·분석용 비전 모델. 없으면 gemini-2.5-flash.
GEMINI_VISION_MODEL=
# 있으면 사진 분석을 Claude(claude-opus-5)가 맡습니다. 선택 사항.
ANTHROPIC_API_KEY=
# 1 이면 AI 를 부르지 않고 기존 견종 캐릭터로 흐름만 보여 주는 데모 모드. 개발 중 키가 없으면 자동으로 켜져요.
CHARACTER_MOCK=
